{
  "dashboard": {
    "id": null,
    "title": "Kensington Contact Center - Daily Performance Analytics",
    "tags": ["kensington", "contact-center", "daily", "performance", "analytics"],
    "style": "dark",
    "timezone": "Europe/London",
    "refresh": "5m",
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "📊 Daily Performance Overview",
        "type": "stat",
        "gridPos": {"h": 6, "w": 24, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(aws_connect_exporter_historical_queue_contacts_queued_today)",
            "legendFormat": "Total Queued Today",
            "refId": "A"
          },
          {
            "expr": "sum(aws_connect_exporter_historical_queue_contacts_abandoned_today)",
            "legendFormat": "Abandoned Today",
            "refId": "B"
          },
          {
            "expr": "sum(aws_connect_exporter_historical_queue_contacts_abandoned_today) / sum(aws_connect_exporter_historical_queue_contacts_queued_today) * 100",
            "legendFormat": "Abandonment Rate %",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 10},
                {"color": "red", "value": 20}
              ]
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Abandonment Rate %"},
              "properties": [
                {"id": "unit", "value": "percent"},
                {"id": "decimals", "value": 1},
                {"id": "thresholds", "value": {
                  "steps": [
                    {"color": "green", "value": null},
                    {"color": "yellow", "value": 5},
                    {"color": "red", "value": 15}
                  ]
                }}
              ]
            }
          ]
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "horizontal",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center"
        }
      },
      {
        "id": 2,
        "title": "📈 7-Day Contact Volume Trend",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
        "targets": [
          {
            "expr": "aws_connect_exporter_historical_queue_contacts_queued_today",
            "legendFormat": "{{queue_name}} - Queued",
            "refId": "A"
          },
          {
            "expr": "aws_connect_exporter_historical_queue_contacts_abandoned_today",
            "legendFormat": "{{queue_name}} - Abandoned",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisLabel": "Contacts",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "line",
              "fillOpacity": 20,
              "gradientMode": "opacity",
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              },
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "pointSize": 5,
              "scaleDistribution": {"type": "linear"},
              "showPoints": "auto",
              "spanNulls": false,
              "stacking": {"group": "A", "mode": "none"},
              "thresholdsStyle": {"mode": "off"}
            },
            "unit": "short",
            "min": 0
          }
        },
        "options": {
          "tooltip": {"mode": "multi"},
          "legend": {
            "calcs": ["mean", "max", "sum"],
            "displayMode": "table",
            "placement": "bottom"
          }
        }
      },
      {
        "id": 3,
        "title": "🎯 Queue Performance Analysis",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
        "targets": [
          {
            "expr": "aws_connect_exporter_historical_queue_contacts_abandoned_today / aws_connect_exporter_historical_queue_contacts_queued_today * 100",
            "legendFormat": "{{queue_name}} Abandonment Rate",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "custom": {
              "displayMode": "gradient",
              "orientation": "horizontal"
            },
            "unit": "percent",
            "min": 0,
            "max": 30,
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 5},
                {"color": "orange", "value": 10},
                {"color": "red", "value": 15}
              ]
            }
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true
        }
      },
      {
        "id": 4,
        "title": "📋 Daily Performance by Queue and Channel",
        "type": "table",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14},
        "targets": [
          {
            "expr": "aws_connect_exporter_historical_queue_contacts_queued_today",
            "legendFormat": "{{queue_name}} ({{channel}})",
            "refId": "A",
            "format": "table",
            "instant": true
          },
          {
            "expr": "aws_connect_exporter_historical_queue_contacts_abandoned_today",
            "legendFormat": "{{queue_name}} ({{channel}})",
            "refId": "B",
            "format": "table",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "custom": {
              "align": "center",
              "displayMode": "color-background"
            },
            "thresholds": {
              "steps": [
                {"color": "transparent", "value": null},
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 20},
                {"color": "red", "value": 50}
              ]
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "queue_name"},
              "properties": [
                {"id": "displayName", "value": "Queue"},
                {"id": "custom.width", "value": 150},
                {"id": "color", "value": {"mode": "fixed", "fixedColor": "transparent"}}
              ]
            },
            {
              "matcher": {"id": "byName", "options": "channel"},
              "properties": [
                {"id": "displayName", "value": "Channel"},
                {"id": "custom.width", "value": 80},
                {"id": "color", "value": {"mode": "fixed", "fixedColor": "transparent"}}
              ]
            },
            {
              "matcher": {"id": "byRegexp", "options": "Abandonment.*"},
              "properties": [
                {"id": "unit", "value": "percent"},
                {"id": "custom.displayMode", "value": "color-background"},
                {"id": "thresholds", "value": {
                  "steps": [
                    {"color": "green", "value": null},
                    {"color": "yellow", "value": 5},
                    {"color": "red", "value": 15}
                  ]
                }}
              ]
            }
          ]
        },
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "calculateField",
            "options": {
              "alias": "Abandonment Rate %",
              "binary": {
                "left": "Value #B",
                "operator": "/",
                "reducer": "sum",
                "right": "Value #A"
              },
              "mode": "binary",
              "reduce": {
                "reducer": "sum"
              }
            }
          },
          {
            "id": "calculateField",
            "options": {
              "alias": "Abandonment Rate %",
              "binary": {
                "left": "Abandonment Rate %",
                "operator": "*",
                "reducer": "sum",
                "right": "100"
              },
              "mode": "binary",
              "reduce": {
                "reducer": "sum"
              },
              "replaceFields": true
            }
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "region": true,
                "queue_id": true,
                "queue_type": true,
                "__name__": true
              },
              "indexByName": {},
              "renameByName": {
                "Value #A": "Contacts Queued",
                "Value #B": "Contacts Abandoned",
                "Abandonment Rate %": "Abandonment Rate %"
              }
            }
          }
        ]
      },
      {
        "id": 5,
        "title": "📞 Channel Distribution Today",
        "type": "piechart",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 22},
        "targets": [
          {
            "expr": "sum by (channel) (aws_connect_exporter_historical_queue_contacts_queued_today)",
            "legendFormat": "{{channel}} Channel",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              }
            },
            "unit": "short"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "pieType": "donut",
          "tooltip": {"mode": "single"},
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "values": ["value", "percent"]
          },
          "displayLabels": ["name", "value"]
        }
      },
      {
        "id": 6,
        "title": "🎯 Performance KPIs",
        "type": "stat",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 22},
        "targets": [
          {
            "expr": "avg(aws_connect_exporter_historical_queue_contacts_abandoned_today / aws_connect_exporter_historical_queue_contacts_queued_today * 100)",
            "legendFormat": "Avg Abandonment Rate",
            "refId": "A"
          },
          {
            "expr": "sum(aws_connect_exporter_historical_queue_contacts_queued_today)",
            "legendFormat": "Total Volume Today",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 15}
              ]
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Avg Abandonment Rate"},
              "properties": [
                {"id": "unit", "value": "percent"},
                {"id": "decimals", "value": 1}
              ]
            },
            {
              "matcher": {"id": "byName", "options": "Total Volume Today"},
              "properties": [
                {"id": "unit", "value": "short"},
                {"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}
              ]
            }
          ]
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "horizontal",
          "textMode": "value_and_name",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center"
        }
      }
    ],
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "editable": true,
    "gnetId": null,
    "graphTooltip": 1,
    "links": [
      {
        "asDropdown": false,
        "icon": "external link",
        "includeVars": false,
        "keepTime": false,
        "tags": ["kensington"],
        "title": "Real-time Operations Dashboard",
        "tooltip": "Switch to real-time operations view",
        "type": "dashboards",
        "url": ""
      }
    ],
    "liveNow": false,
    "panels": [],
    "schemaVersion": 30,
    "version": 1,
    "weekStart": "monday"
  }
}